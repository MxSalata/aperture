<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-aperture.ZPM">
    <Module>
      <Name>iris-aperture</Name>
      <Version>1.0.1</Version>
      <Description>Aperture: a modern management portal for InterSystems IRIS built on the SysAdmin REST API (/api/admin v2). Dashboard, databases, namespaces, processes, devices, journals, tasks, security (users, roles, web applications, TLS, X.509, wallet, OAuth 2.0), a Job Center for asynchronous operations, a spec-driven explorer for all 273 API operations, and a read-only Embedded Python log reader (/api/aperture) for messages.log, alerts.log and SystemMonitor.log, which the SysAdmin API does not expose.</Description>
      <Keywords>management portal,sysadmin,rest,admin,dashboard,logs,contest,react,embedded python</Keywords>
      <Author>
        <Person>MxSalata</Person>
        <CopyrightDate>2026</CopyrightDate>
        <License>MIT</License>
      </Author>
      <Packaging>module</Packaging>
      <SourcesRoot>ipm</SourcesRoot>
      <!-- The portal speaks SysAdmin API v2, which ships with IRIS 2026.2 (2026.1 serves v1 only,
           older releases none); the installer's Embedded Python needs 2021.2+ -->
      <SystemRequirements Version=">=2026.2"/>

      <!-- Post-install hook and readiness report, written in Embedded Python
           (ipm/cls/Aperture/Installer.cls) -->
      <Resource Name="Aperture.Installer.CLS"/>

      <!-- The log reader: a %CSP.REST dispatch class (ipm/cls/Aperture/API.cls) over an Embedded
           Python file reader (ipm/cls/Aperture/Logs.cls). Read-only; needs %Admin_Operate:USE. -->
      <Resource Name="Aperture.API.CLS"/>
      <Resource Name="Aperture.Logs.CLS"/>

      <!-- The built portal (www/, from `npm run build:www`) is copied under the instance's
           csp directory ... -->
      <FileCopy Name="www/" Target="{$cspdir}aperture/"/>

      <!-- ... and served by IRIS as a static web application. Every attribute is a
           Security.Applications property (IPM validates them). AutheEnabled 64 =
           unauthenticated: the files are public, the API calls carry their own JWT or
           Basic credentials. -->
      <WebApplication
        Name="/aperture"
        NameSpace="%SYS"
        Description="Aperture management portal (static SPA)"
        Path="{$cspdir}aperture/"
        Enabled="1"
        ServeFiles="1"
        Recurse="1"
        AutheEnabled="64"
        UseCookies="2"
        CookiePath="/aperture/"
        CSPZENEnabled="0"
      />

      <!-- The log reader's web application, in the namespace the package is installed in (where
           Aperture.API is compiled): password authentication only, like /api/mgmnt, and the
           %Admin_Operate resource, which is what reading messages.log needs. Unlike /aperture
           above it runs a class, so CSPZENEnabled stays at its default (1): with it off, IRIS
           answers 404 to every request for a dispatch class (CI run 36070001055). -->
      <WebApplication
        Name="/api/aperture"
        Description="Aperture log reader (read-only REST API over messages.log, alerts.log, SystemMonitor.log)"
        DispatchClass="Aperture.API"
        Enabled="1"
        AutheEnabled="32"
        Resource="%Admin_Operate"
        UseCookies="1"
        CookiePath="/api/aperture/"
        Recurse="1"
        CSPZENEnabled="1"
      />

      <!-- Enable /api/admin with password + JWT authentication, then print the readiness report -->
      <Invoke Class="Aperture.Installer" Method="Configure" Phase="Configure" When="After"/>
      <Invoke Class="Aperture.Installer" Method="Doctor" Phase="Activate" When="After"/>
    </Module>
  </Document>
</Export>
