            "IsAdapter": "Core",
            "Name": "Comment",
            "Value": "Sends a message every ten seconds",
            "ValueSource": 1,
            "DefaultValue": "",
            "DefaultSource": 3,
            "Description": "Optional comment text for this component.",
            "DataType": "%Library.String",
            "MAXLEN": "2000",
            "MINVAL": "",
            "MAXVAL": "",
            "VALUELIST": "",
