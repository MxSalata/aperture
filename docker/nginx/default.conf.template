# Aperture behind nginx: serves the SPA and reverse-proxies the SysAdmin API so the
# browser never has to deal with CORS or Basic-auth pop-ups.
#
# IRIS_UPSTREAM        e.g. http://iris:52773        (compose default)
# IRIS_API_PREFIX      e.g. /api/admin  or  /iris/api/admin  (behind a web gateway with an instance prefix)
# IRIS_ALLOWED_ORIGINS extra origins the Content-Security-Policy lets the browser call directly,
#                      space separated; empty = same origin only. Rarely useful: /api/admin/v2
#                      sends no CORS headers (by design, InterSystems, 22 September 2026), so a
#                      browser cannot call another IRIS directly. Only a proxy of your own that adds
#                      CORS headers in front of that instance would need to be listed here.
#
# Several instances behind this one nginx: give each its own path prefix and proxy it like
# /api/admin/ below, then save a connection profile in Aperture whose base URL is the prefix
# (Connections → Add → Base URL "/iris-b"). Same origin, so no CORS and no browser dialogs:
#
#   location /iris-b/api/admin/ {
#     proxy_pass http://iris-b:52773/api/admin/;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_read_timeout 300s;
#     proxy_hide_header WWW-Authenticate;
#     add_header X-Aperture-WWW-Authenticate $upstream_http_www_authenticate always;
#     proxy_redirect off;
#   }
#   location /iris-b/api/monitor/ { proxy_pass http://iris-b:52773/api/monitor/; proxy_hide_header WWW-Authenticate; }
#   location /iris-b/api/mgmnt/   { proxy_pass http://iris-b:52773/api/mgmnt/;   proxy_hide_header WWW-Authenticate; }
#   location /iris-b/api/aperture/ { proxy_pass http://iris-b:52773/api/aperture/; proxy_hide_header WWW-Authenticate; }
#   location /iris-b/api/atelier/  { proxy_pass http://iris-b:52773/api/atelier/;  proxy_read_timeout 300s; proxy_hide_header WWW-Authenticate; }
#   location /iris-b/api/interop-editors/ { proxy_pass http://iris-b:52773/api/interop-editors/; proxy_hide_header WWW-Authenticate; }
#   location /iris-b/csp/fhir-management/api/ { proxy_pass http://iris-b:52773/csp/fhir-management/api/; proxy_hide_header WWW-Authenticate; }
#
# Every API a screen reads needs its prefixed location: a path left out reaches the SPA fallback,
# which answers with index.html, and the screen says the path did not reach IRIS.
#
# The FHIR screens of a prefixed instance read its endpoints at /iris-b/csp/healthshare/...: copy the
# regex location of /csp/healthshare below with the prefix in front, and rewrite it away
# (rewrite ^/iris-b(/.*)$ $1 break; proxy_pass http://iris-b:52773;). IRIS_API_PREFIX applies to
# /api/admin only; the other locations go to IRIS_UPSTREAM as they are.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;
  gzip_min_length 1024;

  # Security headers. `always` keeps them on error responses; nginx drops server-level
  # add_header directives in any location that declares its own, hence the repeats below.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

  # The SysAdmin API, same origin as the app.
  location /api/admin/ {
    proxy_pass ${IRIS_UPSTREAM}${IRIS_API_PREFIX}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Authorization is forwarded like any request header; nothing to configure for it.
    proxy_read_timeout 300s;
    # Never let a 401 trigger the browser's native Basic-auth dialog. The scheme still matters to
    # sign-in (Basic on POST /login means JWT is switched off), so it is passed on under another name.
    proxy_hide_header WWW-Authenticate;
    add_header X-Aperture-WWW-Authenticate $upstream_http_www_authenticate always;
    # A location with its own add_header inherits none of the server's: repeat them.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    # Location headers of 202 responses are relative on IRIS; keep them.
    proxy_redirect off;
  }

  # Native monitor API (OpenMetrics + alerts.log), used by the Host monitor screen.
  location /api/monitor/ {
    proxy_pass ${IRIS_UPSTREAM}/api/monitor/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header WWW-Authenticate;
  }

  # Aperture's own log reader (the /api/aperture web application the IPM package creates:
  # messages.log, alerts.log, SystemMonitor.log). Password authentication; its 401 names Basic.
  location /api/aperture/ {
    proxy_pass ${IRIS_UPSTREAM}/api/aperture/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_hide_header WWW-Authenticate;
  }

  # FHIR Server Management API (the FHIR screens), and FHIR endpoints, whose CapabilityStatements
  # the screens read.
  location /csp/fhir-management/api/ {
    proxy_pass ${IRIS_UPSTREAM}/csp/fhir-management/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header WWW-Authenticate;
  }
  # Only what the screens ask of an endpoint, without credentials: its /metadata, and a search of one
  # resource type that says whether it answers anyone. Nothing else of /csp/healthshare is served on
  # this origin, and no credentials are passed on.
  location ~ ^/csp/healthshare/[^/]+/fhir/[^/]+/(metadata|[A-Z][A-Za-z]+)$ {
    limit_except GET { deny all; }
    proxy_pass ${IRIS_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_hide_header WWW-Authenticate;
    proxy_hide_header Set-Cookie;
  }

  # The Atelier API (the SQL screen). It takes a password; its 401 names Basic. A long query may
  # take a while.
  location /api/atelier/ {
    proxy_pass ${IRIS_UPSTREAM}/api/atelier/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_hide_header WWW-Authenticate;
  }

  # IRIS's interoperability API (the Productions screens). It takes the session's own token.
  location /api/interop-editors/ {
    proxy_pass ${IRIS_UPSTREAM}/api/interop-editors/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header WWW-Authenticate;
  }

  # REST management API (REST services screen). It takes a password; its 401 names Basic.
  location /api/mgmnt/ {
    proxy_pass ${IRIS_UPSTREAM}/api/mgmnt/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header WWW-Authenticate;
  }

  # Static assets are content-hashed: cache hard.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  # The mock service worker must always be fresh (demo mode).
  location = /mockServiceWorker.js {
    add_header Cache-Control "no-cache";
    add_header Service-Worker-Allowed "/";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  # SPA fallback.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    try_files $uri $uri/ /index.html;
  }
}
