# Aperture behind nginx: serves the SPA and reverse-proxies the SysAdmin API so the
# browser never has to deal with CORS or Basic-auth pop-ups.
#
# IRIS_UPSTREAM        e.g. http://iris:52773        (compose default)
# IRIS_API_PREFIX      e.g. /api/admin  or  /iris/api/admin  (behind a web gateway with an instance prefix)
# IRIS_ALLOWED_ORIGINS extra origins the Content-Security-Policy lets the browser call directly,
#                      space separated; empty = same origin only. Rarely useful: /api/admin/v2
#                      sends no CORS headers (by design, InterSystems, 22 September 2026), so a
#                      browser cannot call another IRIS directly. Only a proxy of your own that adds
#                      CORS headers in front of that instance would need to be listed here.
#
# Several instances behind this one nginx: give each its own path prefix and proxy it like
# /api/admin/ below, then save a connection profile in Aperture whose base URL is the prefix
# (Connections → Add → Base URL "/iris-b"). Same origin, so no CORS and no browser dialogs:
#
#   location /iris-b/api/admin/ {
#     proxy_pass http://iris-b:52773/api/admin/;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_read_timeout 300s;
#     proxy_hide_header WWW-Authenticate;
#     add_header X-Aperture-WWW-Authenticate $upstream_http_www_authenticate always;
#     proxy_redirect off;
#   }
#   location /iris-b/api/monitor/ { proxy_pass http://iris-b:52773/api/monitor/; proxy_hide_header WWW-Authenticate; }
#   location /iris-b/api/mgmnt/   { proxy_pass http://iris-b:52773/api/mgmnt/;   proxy_hide_header WWW-Authenticate; }

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;
  gzip_min_length 1024;

  # Security headers. `always` keeps them on error responses; nginx drops server-level
  # add_header directives in any location that declares its own, hence the repeats below.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

  # The SysAdmin API, same origin as the app.
  location /api/admin/ {
    proxy_pass ${IRIS_UPSTREAM}${IRIS_API_PREFIX}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Authorization is forwarded like any request header; nothing to configure for it.
    proxy_read_timeout 300s;
    # Never let a 401 trigger the browser's native Basic-auth dialog. The scheme still matters to
    # sign-in (Basic on POST /login means JWT is switched off), so it is passed on under another name.
    proxy_hide_header WWW-Authenticate;
    add_header X-Aperture-WWW-Authenticate $upstream_http_www_authenticate always;
    # A location with its own add_header inherits none of the server's: repeat them.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    # Location headers of 202 responses are relative on IRIS; keep them.
    proxy_redirect off;
  }

  # Native monitor API (OpenMetrics + alerts.log), used by the Host monitor screen.
  location /api/monitor/ {
    proxy_pass ${IRIS_UPSTREAM}/api/monitor/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_hide_header WWW-Authenticate;
  }

  # REST management API (REST services screen). It takes a password; its 401 names Basic.
  location /api/mgmnt/ {
    proxy_pass ${IRIS_UPSTREAM}/api/mgmnt/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_hide_header WWW-Authenticate;
  }

  # Static assets are content-hashed: cache hard.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  # The mock service worker must always be fresh (demo mode).
  location = /mockServiceWorker.js {
    add_header Cache-Control "no-cache";
    add_header Service-Worker-Allowed "/";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  # SPA fallback.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${IRIS_ALLOWED_ORIGINS}; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    try_files $uri $uri/ /index.html;
  }
}
