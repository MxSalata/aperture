# Copy to .env, which is never committed. The Vite dev server reads the VITE_ settings, docker
# compose the others.

# Development (npm run dev)
# URL of the IRIS instance the Vite dev server proxies /api/admin to.
VITE_IRIS_URL=http://localhost:52773
# Sub-path the app is served from (GitHub Pages uses /<repo>/).
VITE_BASE=/
# Origins besides its own that the builds with a Content-Security-Policy of their own (www/, the
# demo) may call, space-separated: only for a proxy of yours that sends CORS headers.
# VITE_CONNECT_SRC=

# Docker (docker-compose.yml, docker-compose.build.yml)
# The password of _SYSTEM, SuperUser and the image's other accounts, applied at the container's
# first start (a restart keeps passwords changed in IRIS since). IRIS's rules apply (by default 3 to
# 32 letters, digits and punctuation). Empty keeps the demonstration password SYS.
IRIS_PASSWORD=
# Where the ports are published: 127.0.0.1, this machine only (the default), or 0.0.0.0.
APERTURE_BIND=127.0.0.1
# The image tag docker-compose.yml runs: latest, a released version (the repository's tags without
# the v, such as 1.0.4), or edge (the development branch).
APERTURE_VERSION=latest
